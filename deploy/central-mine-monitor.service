# پایش بیرونی — هر ۵ دقیقه یک‌بار؛ خرابی = کد خروج ۲ = unit شکست‌خورده
[Unit]
Description=CENTRAL MINE — پایش سلامتی و زنجیرهٔ ممیزی
After=central-mine.service

[Service]
Type=oneshot
User=central
Group=central
WorkingDirectory=/opt/central-mine
EnvironmentFile=/etc/central-mine/central-mine.env
# CM_PUBLIC_BASE_URL در فایل محیط تعریف شده است
ExecStart=/usr/bin/node scripts/monitor.js --url ${CM_PUBLIC_BASE_URL} --max-backup-hours 36
# برای هشدار به اسلک/تلگرام، webhook را بدهید:
# ExecStart=/usr/bin/node scripts/monitor.js --url ${CM_PUBLIC_BASE_URL} --webhook https://hooks.slack.com/services/XXX
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/central-mine
