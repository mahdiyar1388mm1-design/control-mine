# ==========================================================================
# CENTRAL MINE — نمونهٔ متغیرهای محیطی برای «تولید»
# ==========================================================================
# این فایل را روی سرور به /etc/central-mine/central-mine.env کپی کنید،
# مقادیر خالی را پر کنید، و مجوزش را 0600 بگذارید:
#
#   sudo install -d -m 0750 -o central /etc/central-mine
#   sudo install -m 0600 -o central deploy/production.env.example /etc/central-mine/central-mine.env
#   sudo -u central nano /etc/central-mine/central-mine.env
#
# ساخت کلیدها:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"   # CM_SECRET
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   # CM_BACKUP_KEY
# ==========================================================================

# ---------- ۱) اجرا ----------
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# دامنهٔ عمومی با HTTPS — مبنای کوکی امن، لینک پرداخت و sitemap.
CM_PUBLIC_BASE_URL=https://example.com
CM_TRUST_PROXY=true

# ---------- ۲) کلیدها (اجباری) ----------
CM_SECRET=
CM_BACKUP_KEY=
# خالی = مسیر نگهداری بسته است. اگر monitor.js روی ماشین دیگری اجرا می‌شود،
# همین مقدار را آنجا هم بگذارید تا زنجیرهٔ ممیزی را از بیرون بررسی کند.
CM_MAINTENANCE_TOKEN=

# ---------- ۳) داده ----------
CM_DATA_DIR=/var/lib/central-mine
CM_STORAGE_DIR=/var/lib/central-mine/storage
# CM_DB_PATH=/var/lib/central-mine/central-mine.db

# ---------- ۴) سیاست امنیتی ----------
CM_PASSWORD_MIN_LENGTH=12
CM_LOGIN_MAX_FAILURES=5
CM_LOGIN_LOCK_MINUTES=15
CM_MFA_ENFORCE=1
# در تولید حتماً 0: کد ورود نباید در پاسخ API برگردد.
CM_OTP_SANDBOX=0
# پشت Nginx با TLS، کوکی‌ها Secure هستند؛ این را 0 نگه دارید.
# CM_INSECURE_COOKIES=0
# سایت نباید داخل iframe بارگذاری شود.
CM_DENY_IFRAME=1
CM_HSTS_MAX_AGE=15552000
# بازنویسی صفحه‌های حذف‌شده (کمی کندتر، بازیابی دادهٔ حذف‌شده سخت‌تر).
CM_SECURE_DELETE=1

# ---------- ۵) سرویس‌های بیرونی (اختیاری) ----------
# تا وقتی خالی‌اند، سیستم در حالت sandbox می‌ماند و /health صادقانه
# real_connected:false گزارش می‌کند. با پر کردن این‌ها، درگاه واقعی فعال می‌شود
# (زرین‌پال) و ارسال پیامک واقعی (کاوه‌نگار یا sms.ir).
#
# CM_PAYMENT_PROVIDER=zarinpal
# CM_PAYMENT_MERCHANT_ID=
# CM_PAYMENT_GATEWAY_URL=https://www.zarinpal.com/pg/StartPay
#
# CM_SMS_PROVIDER=kavenegar      # یا smsir
# CM_SMS_API_KEY=
# CM_SMS_SENDER=
# CM_SMS_TEMPLATE_ID=            # فقط برای sms.ir

# ---------- ۶) نمونه ----------
# اگر بیش از یک نمونه پشت load balancer دارید، در هر کدام یکتا باشد.
# CM_INSTANCE_ID=server-1
