# ==========================================================================
# CENTRAL MINE — Nginx reverse proxy (TLS termination)
# ==========================================================================
# نصب:
#   sudo install -m 0644 deploy/nginx.conf.example /etc/nginx/sites-available/central-mine
#   sudo ln -s /etc/nginx/sites-available/central-mine /etc/nginx/sites-enabled/
#   sudo certbot --nginx -d example.com -d www.example.com
#   sudo nginx -t && sudo systemctl reload nginx
#
# نکته: Express خودش SPA را سرو می‌کند و /api/v1، /uploads و /health را
# هم دارد؛ Nginx فقط TLS، هدرهای امنیتی و محدودیت نرخ لبه را اضافه می‌کند.
# ==========================================================================

upstream central_mine_app {
    server 127.0.0.1:3000;
    keepalive 32;
}

# محدودیت نرخ لبه برای مقابله با سیل درخواست پیش از رسیدن به node
limit_req_zone $binary_remote_addr zone=cm_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=cm_auth:10m rate=2r/s;

server {
    listen 80;
    listen [::]:80;
    server_name example.com www.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name example.com www.example.com;

    # گواهی Let's Encrypt (certbot این خطوط را می‌نویسد)
    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    # --- هدرهای امنیتی ---
    add_header Strict-Transport-Security "max-age=15552000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # حجم آپلود: هماهنگ با CM_MAX_UPLOAD_BYTES (پیش‌فرض ۱۰ مگابایت)
    client_max_body_size 12m;
    client_body_timeout 30s;
    client_header_timeout 15s;

    # --- فشرده‌سازی ---
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript
               application/xml image/svg+xml font/woff2;

    # --- فایل‌های استاتیک بیلد با کش طولانی (نام‌ها hash دارند) ---
    location /assets/ {
        proxy_pass http://central_mine_app;
        proxy_set_header Host $host;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # --- مسیرهای احراز هویت: محدودیت سخت‌گیرانه‌تر ---
    location ~ ^/api/v1/auth/(login|register|otp|mfa) {
        limit_req zone=cm_auth burst=10 nodelay;
        proxy_pass http://central_mine_app;
        include /etc/nginx/snippets/central-mine-proxy.conf;
    }

    # --- API ---
    location /api/ {
        limit_req zone=cm_api burst=40 nodelay;
        proxy_pass http://central_mine_app;
        include /etc/nginx/snippets/central-mine-proxy.conf;
        proxy_read_timeout 60s;
    }

    # --- درگاه پرداخت: بازگشت از بانک با query طولانی می‌آید ---
    location /pay/result {
        proxy_pass http://central_mine_app;
        include /etc/nginx/snippets/central-mine-proxy.conf;
    }

    # --- پایش: فقط از شبکهٔ داخلی؟ اگر بیرونی است، دسترسی محدود کنید ---
    location = /health {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        deny all;
        proxy_pass http://central_mine_app;
    }
    location = /ready {
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        deny all;
        proxy_pass http://central_mine_app;
    }

    # --- SPA + آپلودها ---
    location / {
        proxy_pass http://central_mine_app;
        include /etc/nginx/snippets/central-mine-proxy.conf;
    }

    access_log /var/log/nginx/central-mine.access.log;
    error_log  /var/log/nginx/central-mine.error.log warn;
}

# --------------------------------------------------------------------------
# /etc/nginx/snippets/central-mine-proxy.conf
# (این بلوک را جدا ذخیره کنید تا تکرار نشود)
#
#   proxy_http_version 1.1;
#   proxy_set_header Host              $host;
#   proxy_set_header X-Real-IP         $remote_addr;
#   proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#   proxy_set_header X-Forwarded-Proto $scheme;
#   proxy_set_header X-Forwarded-Host  $host;
#   proxy_set_header Connection        "";
#   proxy_buffering off;   # پاسخ‌های استریم/SSE سالم بمانند
# --------------------------------------------------------------------------
