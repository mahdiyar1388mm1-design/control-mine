# پشتیبان روزانه — سرویس یک‌باره (systemd timer آن را صدا می‌زند)
[Unit]
Description=CENTRAL MINE — پشتیبان رمزنگاری‌شدهٔ دیتابیس
After=central-mine.service

[Service]
Type=oneshot
User=central
Group=central
WorkingDirectory=/opt/central-mine
EnvironmentFile=/etc/central-mine/central-mine.env
ExecStart=/usr/bin/node scripts/backup.js --keep 14 --verify
# اگر پشتیبان یا تأیید آن شکست بخورد، unit شکست‌خورده علامت می‌خورد (systemctl --failed)
SuccessExitStatus=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/central-mine
