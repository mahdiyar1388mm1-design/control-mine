# CENTRAL MINE — نمونهٔ متغیرهای محیطی (بدون کلید واقعی)
# در محیط تولید یک فایل .env جداگانه بیرون از مخزن گیت بسازید.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# مسیر پایگاه داده و فایل‌های خصوصی
CM_DATA_DIR=./data
CM_STORAGE_DIR=./storage

# کلید امضای نشست‌ها و callback آزمایشی (در تولید حداقل ۶۴ کاراکتر تصادفی اجباری است)
CM_SECRET=replace-with-strong-random-64-hex-in-production

# مدت اعتبار نشست به ثانیه (پیش‌فرض ۷ روز)
CM_TOKEN_TTL=604800

# حالت آزمایشی OTP (در تولید پس از اتصال سرویس پیامک معتبر روی 0 قرار گیرد)
CM_OTP_SANDBOX=1

# کلید رمزنگاری پشتیبان‌گیری AES-256-GCM (برای اسکریپت npm run backup)
CM_BACKUP_KEY=

# در محیط تولید مستقل برای جلوگیری از بارگذاری در iframe روی 1 قرار دهید
CM_DENY_IFRAME=0
