# ==========================================================================
# CENTRAL MINE — نمونهٔ متغیرهای محیطی
# ==========================================================================
# استفاده: این فایل را به `server/.env` (یا `.env` در ریشهٔ مخزن) کپی کنید.
#   cp .env.example server/.env
# سرور خودش فایل را می‌خواند (server/src/utils/loadEnv.js) — نیازی به
# `export` دستی یا نصب dotenv نیست. متغیری که در محیط شل ست شده باشد همیشه
# بر فایل `.env` اولویت دارد.
#
# ⚠️ این فایل هرگز نباید کلید واقعی داشته باشد؛ `.env` در .gitignore است.
# ==========================================================================


# ---------- ۱) اجرا (اجباری) ----------
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# دامنهٔ عمومی سایت؛ مبنای URL کانونیکال، sitemap، کوکی‌ها و لینک پرداخت.
CM_PUBLIC_BASE_URL=https://example.com

# پشت Nginx/Caddy یک hop پروکسی داریم؛ اگر مستقیم سرو می‌شود false بگذارید.
CM_TRUST_PROXY=true


# ---------- ۲) کلیدهای امنیتی (اجباری در تولید) ----------
# سرور بدون این کلید در NODE_ENV=production بالا نمی‌آید.
# ساخت مقدار امن:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CM_SECRET=

# کلید AES-256-GCM برای پشتیبان‌گیری رمزنگاری‌شده (۳۲ بایت هگز = ۶۴ نویسه).
# اگر خالی بماند، پشتیبان‌ها رمزنگاری نمی‌شوند و در مرکز امنیت هشدار می‌گیرید.
# ساخت کلید:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CM_BACKUP_KEY=

# توکن عملیات نگهداری (POST /api/v1/maintenance/housekeeping با هدر x-maintenance-token).
# خالی = این مسیر کامل بسته است (پیش‌فرض امن).
CM_MAINTENANCE_TOKEN=


# ---------- ۳) مسیر داده و فایل‌ها ----------
# دیتابیس SQLite (node:sqlite) و فایل‌های خصوصی. در تولید روی دیسک پایدار
# (volume) بگذارید و از این مسیر پشتیبان بگیرید.
CM_DATA_DIR=./data
CM_STORAGE_DIR=./storage
# مسیر کامل فایل دیتابیس اگر با CM_DATA_DIR متفاوت است:
# CM_DB_PATH=/var/lib/central-mine/central-mine.db


# ---------- ۴) عمر نشست‌ها ----------
# توکن دسترسی (ثانیه) — پیش‌فرض ۱۲ ساعت. کوتاه‌تر امن‌تر است.
CM_TOKEN_TTL=43200
# توکن تازه‌سازی چرخشی (ثانیه) — پیش‌فرض ۳۰ روز.
CM_REFRESH_TTL=2592000
# بیکاری مجاز نشست (ثانیه) — پیش‌فرض ۱۴ روز.
CM_SESSION_IDLE=1209600
# پنجرهٔ احراز مجدد برای عملیات حساس مدیر (دقیقه).
CM_SENSITIVE_REAUTH_MINUTES=15


# ---------- ۵) سیاست امنیتی ----------
# حداقل طول رمز عبور.
CM_PASSWORD_MIN_LENGTH=12
# تعداد رمزهای قبلی که نمی‌توان دوباره استفاده کرد.
CM_PASSWORD_HISTORY=5
# قفل حساب پس از N تلاش ناموفق در پنجرهٔ زیر.
CM_LOGIN_MAX_FAILURES=5
CM_LOGIN_LOCK_MINUTES=15
CM_LOGIN_ATTEMPT_WINDOW=30
# سقف درخواست هر IP در دقیقه (کل API / مسیرهای احراز هویت).
CM_API_RATE_LIMIT=600
CM_AUTH_RATE_LIMIT=20
# کوکی‌های Secure در تولید پیش‌فرض روشن‌اند؛ فقط اگر TLS ندارید 1 بگذارید
# (توصیه نمی‌شود — به‌جای آن HTTPS را فعال کنید).
# CM_INSECURE_COOKIES=0
# HSTS (ثانیه) — پیش‌فرض ۱۸۰ روز.
CM_HSTS_MAX_AGE=15552000
# جلوگیری از بارگذاری سایت در iframe. در تولید 1 بگذارید؛ پیش‌نمایش Arena به 0 نیاز دارد.
CM_DENY_IFRAME=0
# اجبار ورود دومرحله‌ای برای نقش‌های مدیریتی.
CM_MFA_ENFORCE=1
# حذف داده‌های کهنه (روز) در عملیات نگهداری.
CM_DATA_RETENTION_DAYS=365
# سقف حجم آپلود (بایت) — پیش‌فرض ۱۰ مگابایت.
CM_MAX_UPLOAD_BYTES=10485760
# بازنویسی صفحه‌های حذف‌شده با صفر (کمی کندتر، بازیابی دادهٔ حذف‌شده سخت‌تر).
CM_SECURE_DELETE=0


# ---------- ۶) سرویس‌های بیرونی ----------
# درگاه پرداخت و پیامک در نسخهٔ فعلی «سندباکس» هستند (بدون کلید).
# وقتی درگاه واقعی وصل شد، این بخش جای کلیدهای آن است و مقدارهای
# `integrations` در /health از sandbox به live تغییر می‌کند.
#
# CM_PAYMENT_PROVIDER=zarinpal
# CM_PAYMENT_MERCHANT_ID=
# CM_PAYMENT_CALLBACK_URL=https://example.com/api/v1/payments/callback
#
# CM_SMS_PROVIDER=kavenegar
# CM_SMS_API_KEY=
# CM_SMS_SENDER=

# حالت سندباکس OTP: کد ورود در پاسخ API برگردانده می‌شود.
# در تولید حتماً 0 بگذارید (وگرنه هر کسی می‌تواند کد را ببیند).
CM_OTP_SANDBOX=0

# شناسهٔ این نمونه در قفل توزیع‌شدهٔ زمان‌بند پاداش (در چندسروری یکتا باشد).
# CM_INSTANCE_ID=server-1
